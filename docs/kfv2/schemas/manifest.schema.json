{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kamafeu.studiopomar.com/kfv2/schemas/manifest.schema.json",
  "title": "KFV 2 Voicebank Manifest",
  "description": "Structural schema for kamafeu_voicebank.json. The application applies additional cross-reference, path-safety, and file-content checks after schema validation.",
  "type": "object",
  "required": ["format", "schema_version", "voice_id", "bank_id", "bank_version", "package_revision", "display_name", "publisher", "languages", "phonetic_profiles", "engine", "styles", "layers", "defaults"],
  "properties": {
    "format": { "const": "kamafeu.voicebank" },
    "schema_version": { "type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$" },
    "voice_id": { "$ref": "#/$defs/id" },
    "bank_id": { "$ref": "#/$defs/id" },
    "bank_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "package_revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "display_name": { "$ref": "#/$defs/id" },
    "publisher": { "$ref": "#/$defs/id" },
    "description": { "type": "string" },
    "languages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/language" } },
    "phonetic_profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profileReference" } },
    "engine": { "$ref": "#/$defs/engine" },
    "styles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/style" } },
    "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layer" } },
    "defaults": { "$ref": "#/$defs/defaults" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "license": { "$ref": "#/$defs/license" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
    "relativePath": { "type": "string", "minLength": 1 },
    "profileReference": {
      "type": "object", "required": ["id", "language", "path"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "language": { "$ref": "#/$defs/language" }, "path": { "$ref": "#/$defs/relativePath" } }
    },
    "engine": {
      "type": "object", "required": ["id", "api_major"],
      "properties": {
        "id": { "const": "kamafeu.concat" },
        "api_major": { "const": 1 },
        "required_features": { "type": "array", "uniqueItems": true, "items": { "enum": ["explicit-anchor", "sustain-region", "finite-units"] } }
      }
    },
    "style": { "type": "object", "required": ["id", "display_name"], "properties": { "id": { "$ref": "#/$defs/id" }, "display_name": { "$ref": "#/$defs/id" } } },
    "layer": {
      "type": "object", "required": ["id", "style_id", "recorded_midi", "units_path"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "style_id": { "$ref": "#/$defs/id" }, "recorded_midi": { "type": "integer", "minimum": 0, "maximum": 127 }, "units_path": { "$ref": "#/$defs/relativePath" } }
    },
    "defaults": {
      "type": "object", "required": ["phonetic_profile_id", "style_id", "layer_policy", "missing_unit_policy"],
      "properties": { "phonetic_profile_id": { "$ref": "#/$defs/id" }, "style_id": { "$ref": "#/$defs/id" }, "layer_policy": { "const": "nearest-recorded" }, "missing_unit_policy": { "const": "error" } }
    },
    "presentation": {
      "type": "object", "properties": {
        "avatar": { "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] },
        "portrait": { "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] },
        "accent_color": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "license": { "type": "object", "required": ["id", "path"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/relativePath" } } }
  }
}
